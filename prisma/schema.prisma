// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int     @id @default(autoincrement())
  name      String
  email     String  @unique
  password  String  // bcrypt hash
  status    String  @default("ativo") // "ativo" ou "inativo"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Employee {
  id              Int      @id @default(autoincrement())
  name            String
  cpf             String   @unique
  rg              String
  email           String
  phone           String
  cargo           String
  department      String
  birthDate       DateTime
  hireDate        DateTime
  salary          Float
  address         String
  status          String   @default("Ativo") // "Ativo" ou "Inativo"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  inactivatedAt   DateTime?
  
  auditLogs       AuditLog[]

  @@map("employees")
}

model AuditLog {
  id              String   @id @default(cuid())
  employeeId      Int
  employee        Employee @relation(fields: [employeeId], references: [id])
  action          String   // "CREATE", "UPDATE", "DELETE"
  changedFields   String   // JSON string com as mudanças
  userId          String   // ID do usuário que fez a ação
  createdAt       DateTime @default(now())

  @@map("audit_logs")
}

model Part {
  id              Int      @id @default(autoincrement())
  code            String   @unique
  name            String
  category        String
  quantity        Int
  description     String?
  manufacturer    String?
  serialNumber    String?
  location        String?
  minQuantity     Int?
  status          String   @default("Ativo") // "Ativo" ou "Inativo"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  inactivatedAt   DateTime?

  auditLogs       PartAuditLog[]
  stockMovements  StockMovement[]

  @@map("parts")
}

model PartAuditLog {
  id              String   @id @default(cuid())
  partId          Int
  part            Part     @relation(fields: [partId], references: [id])
  action          String   // "CREATE", "UPDATE", "DELETE"
  changedFields   String
  userId          String
  createdAt       DateTime @default(now())

  @@map("part_audit_logs")
}

model StockMovement {
  id              String   @id @default(cuid())
  partId          Int
  part            Part     @relation(fields: [partId], references: [id])
  type            String   // "ENTRADA" ou "SAIDA"
  quantity        Int
  createdAt       DateTime @default(now())

  @@map("stock_movements")
}
